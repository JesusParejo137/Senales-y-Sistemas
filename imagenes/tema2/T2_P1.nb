Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "fs", ",", "per", ",", "f1", ",", "f3", ",", "f", ",", "tLabels", ",", 
     "ticksT", ",", "ticksY", ",", "panel", ",", "g1", ",", "g3", ",", "gS", 
     ",", "fig"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fs", "=", "20"}], ";"}], "          ", 
  RowBox[{"(*", 
   RowBox[{"tama\[NTilde]o", " ", "de", " ", "fuente", " ", "\[UAcute]nico"}],
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"per", "=", 
    RowBox[{"2", " ", 
     RowBox[{"Pi", "/", "5"}]}]}], ";"}], "     ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"per\[IAcute]odo", " ", "T"}], "=", 
    RowBox[{"2", 
     RowBox[{"\[Pi]", "/", "\[Omega]1"}]}]}], "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f1", "[", "t_", "]"}], ":=", 
   RowBox[{"Cos", "[", 
    RowBox[{
     RowBox[{"5", " ", "t"}], "-", 
     RowBox[{"Pi", "/", "4"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f3", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"15", " ", "t"}], "+", 
      RowBox[{"Pi", "/", "3"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"f1", "[", "t", "]"}], "+", 
     RowBox[{"f3", "[", "t", "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tLabels", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<0\>\"", ",", "\"\<T/2\>\"", ",", "\"\<T\>\"", ",", "\"\<3T/2\>\"", 
     ",", "\"\<2T\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ticksT", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}], " ", 
        RowBox[{"per", "/", "2"}]}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"tLabels", "[", 
          RowBox[{"[", "k", "]"}], "]"}], ",", "fs"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ticksY", "[", "ys_List", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"Style", "[", 
         RowBox[{"y", ",", "fs"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "ys"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"panel", "[", 
    RowBox[{
    "fun_", ",", "col_", ",", "ys_List", ",", "amp_List", ",", "label_", ",", 
     RowBox[{"extra_List", ":", 
      RowBox[{"{", "}"}]}]}], "]"}], ":=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"fun", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", " ", "per"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"2", " ", "per"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotRangePadding", "->", "None"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"col", ",", 
        RowBox[{"AbsoluteThickness", "[", "3", "]"}]}], "]"}]}], ",", 
     RowBox[{"Background", "->", "White"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
     RowBox[{"FrameTicks", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ticksY", "[", "ys", "]"}], ",", "None"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ticksT", ",", "None"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "per", "}"}], ",", 
        RowBox[{"{", "0", "}"}]}], "}"}]}], ",", 
     RowBox[{"GridLinesStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.7", "]"}], ",", 
        RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{"0.01", ",", "0.01"}], "}"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"Prolog", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.5", "]"}], ",", 
        RowBox[{"AbsoluteThickness", "[", "1.5", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{"0.015", ",", "0.015"}], "}"}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"s", " ", "a"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", " ", "per"}], ",", 
               RowBox[{"s", " ", "a"}]}], "}"}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", "amp"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}], 
       "}"}]}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"label", ",", "fs", ",", "Black"}], "]"}], ",", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.015", ",", "0.9"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}], ",", "extra"}], 
       "}"}]}], ",", 
     RowBox[{"AspectRatio", "->", "0.3"}], ",", 
     RowBox[{"ImagePadding", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"75", ",", "15"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"45", ",", "10"}], "}"}]}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Primer", " ", "arm\[OAcute]nico"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g1", "=", 
    RowBox[{"panel", "[", 
     RowBox[{"f1", ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.12", ",", "0.47", ",", "0.71"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", "1", "}"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<f\>\"", ",", "1"}], "]"}], ",", 
