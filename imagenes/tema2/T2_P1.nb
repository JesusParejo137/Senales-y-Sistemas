         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Omega]\>\"", ",", "1"}], "]"}], ",", 
         "\"\< = 5 rad/s\>\""}], "}"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Tercer", " ", "arm\[OAcute]nico"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g3", "=", 
    RowBox[{"panel", "[", 
     RowBox[{"f3", ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.84", ",", "0.15", ",", "0.16"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.5"}], ",", "0", ",", "0.5"}], "}"}], ",", 
      RowBox[{"{", "0.5", "}"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<+  \>\"", ",", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<f\>\"", ",", "3"}], "]"}], ",", 
         "\"\<(t) = 0.5 cos(15t + \[Pi]/3),   \>\"", ",", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Omega]\>\"", ",", "3"}], "]"}], ",", 
         "\"\< = 15 rad/s\>\""}], "}"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
